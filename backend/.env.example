SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# DATABASE_URL, bila diisi, menggantikan seluruh pengaturan DB_*.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=real_clinic
# Isi hanya untuk Unix socket; kosongkan untuk koneksi TCP.
DB_SOCKET=
# Produksi dengan TLS: verify-full dan sertifikat CA yang sesuai.
DB_SSLMODE=disable
DB_SSLROOTCERT=
DB_CONNECT_TIMEOUT=5

# Aktifkan untuk deployment HTTPS.
COOKIE_SECURE=false
SESSION_DURATION=30m

# Migrasi SQL baru dijalankan sebelum API menerima request.
AUTO_MIGRATE=true
# Aktifkan hanya untuk membuat tenant dan akun demo, bukan data operasional.
SEED_ENABLED=false
# Wajib 8-72 byte bila seeder aktif; tidak ada password bawaan.
SEED_PASSWORD=

# Folder lampiran foto (consent, pemeriksaan, tindakan). Simpan di luar folder web dan ikutkan dalam backup.
FILES_DIR=data/files

# Company yang menerima form "Buat Janji" di landing page (UUID). Kosong = hanya superadmin yang melihat.
LANDING_COMPANY_ID=
